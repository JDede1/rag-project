{
  "selectors": {
    "accordion_containers": [
      ".accordion-panel",
      ".accordion-item",
      ".accordion",
      ".accordion-wrapper",
      ".accordion-content",
      ".accordion-body",
      ".accordion-section",
      ".accordion-question",
      ".accordion-answer",
      ".rbc-accordion",
      ".rbc-accordion-item"
    ],

    "faq_blocks": [
      ".faq",
      ".faq-item",
      ".faq-container",
      ".faq-block",
      ".collapse-item",
      ".rbc-faq",
      ".rbc-faq-item",
      ".rbc-faq-block",
      ".rbc-help-faq"
    ],

    "question_elements": [
      "button",
      "h1",
      "h2",
      "h3",
      "h4",
      "strong",
      ".accordion-title",
      ".question",
      ".faq-question",
      ".rbc-faq-question"
    ],

    "answer_elements": [
      "p",
      "div",
      "section",
      ".accordion-body",
      ".accordion-content",
      ".panel-body",
      ".collapse-body",
      ".answer",
      ".faq-answer",
      ".rbc-faq-answer",
      ".rbc-answer-block"
    ],

    "heading_fallbacks": [
      "h2",
      "h3",
      "strong",
      "dt"
    ]
  },

  "extraction": {
    "strip_tags": [
      "script",
      "style",
      "footer",
      "nav",
      "header",
      "img",
      "svg"
    ],
    "noise_patterns": [
      "cookie",
      "privacy",
      "footer",
      "terms",
      "all rights reserved",
      "javascript",
      "legal disclaimer"
    ],
    "min_question_length": 8,
    "min_answer_length": 15,
    "max_fallback_answer_chars": 1500
  },

  "interactive_expansion": {
    "click_selectors": [
      "button",
      ".accordion-title",
      ".faq-question",
      ".question",
      ".toggle",
      ".rbc-accordion-trigger"
    ],
    "scroll_steps": 6,
    "scroll_distance": 600,
    "scroll_delay_ms": 200
  },

  "overrides": {
    "__COMMENT__": "URL-specific overrides go here. Example structure:",
    "__EXAMPLE__": {
      "https://www.example.com/faqs.html": {
        "use_containers": true,
        "use_headings": true,
        "allow_markdown_fallback": false,
        "min_question_length": 10,
        "min_answer_length": 20,
        "container_selectors": [".custom-container"],
        "question_selectors": ["h2", ".custom-question"],
        "answer_selectors": ["p", ".custom-answer"],
        "heading_fallbacks": ["h2", "h3"]
      }
    }
  }
}

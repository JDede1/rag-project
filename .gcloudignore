# =========================================================================
# FINAL .gcloudignore (MUST MATCH DOCKERIGNORE FOR CLOUD RUN)
# =========================================================================

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Git
.git/
.gitignore

# Editors / OS files
.vscode/
.idea/
.DS_Store

# Logs
logs/
*.log

# Notebooks
*.ipynb
.ipynb_checkpoints/

# ============================================================
# Ignore ENTIRE data directory
# ============================================================
data/**

# ============================================================
# BUT explicitly include the ONNX + FAISS index folder
# ============================================================
!data/index/
!data/index/**

# Build artifacts
dist/
build/

# Misc
cloudflared-linux-amd64.deb

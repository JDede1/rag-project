# ============================================================
# PRODUCTION .dockerignore — RAG Backend
# ============================================================
# RULE:
#   We KEEP data/index because FAISS + metadata MUST be inside the image.
#   We IGNORE everything else that is large, experimental, or dev-only.
# ============================================================

# ----------------------
# Python cache
# ----------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# ----------------------
# Virtual environments
# ----------------------
venv/
env/
.env/
*.egg-info/

# ----------------------
# Editors / OS files
# ----------------------
.vscode/
.idea/
.DS_Store

# ----------------------
# Logs (Cloud Run will create its own)
# ----------------------
logs/
*.log

# ----------------------
# Notebooks (local only)
# ----------------------
*.ipynb
.ipynb_checkpoints/

# ----------------------
# Data — EXCLUDE everything except FAISS index
# ----------------------
data/raw/
data/processed/
data/reports/

# CRITICAL: DO NOT IGNORE FAISS INDEX DIRECTORY
# data/index/ is intentionally NOT ignored

# ----------------------
# External tools (not needed in container)
# ----------------------
cloudflared-linux-amd64.deb

# ----------------------
# Build / cache folders
# ----------------------
build/
dist/

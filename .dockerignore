# ============================================================
# PRODUCTION .dockerignore (FINAL — WORKING)
# ============================================================

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
env/
.env/
*.egg-info/

# Editors / OS files
.vscode/
.idea/
.DS_Store

# Logs
logs/
*.log

# Notebooks
*.ipynb
.ipynb_checkpoints/

# ============================================================
# Ignore all data/*
# ============================================================
data/*

# ============================================================
# BUT KEEP data/index (ONNX + FAISS + metadata)
# ============================================================
!data/index/
!data/index/**
!data/index/*
!data/index/**/*

# Build artifacts
build/
dist/

# Misc
cloudflared-linux-amd64.deb

# ============================================================
# PRODUCTION .dockerignore — RAG Backend
# ============================================================
# RULE:
#   KEEP:   data/index/ (FAISS + metadata required in image)
#   IGNORE: data/raw/, processed/, reports/ + dev files
# ============================================================

# ----------------------
# Python cache
# ----------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# ----------------------
# Virtual environments
# ----------------------
venv/
env/
.env/
*.egg-info/

# ----------------------
# Editors / OS files
# ----------------------
.vscode/
.idea/
.DS_Store

# ----------------------
# Logs (Cloud Run creates its own)
# ----------------------
logs/
*.log

# ----------------------
# Notebooks (local-only development)
# ----------------------
*.ipynb
.ipynb_checkpoints/

# ----------------------
# Data — ignore everything except FAISS index
# ----------------------
data/raw/
data/processed/
data/reports/

# ❗Critical:
# data/index/ is intentionally NOT ignored — must be included in Docker.

# ----------------------
# External tools (not needed in container)
# ----------------------
cloudflared-linux-amd64.deb

# ----------------------
# Build / packaging
# ----------------------
build/
dist/

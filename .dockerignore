# ============================================================
# PRODUCTION .dockerignore
# ============================================================

__pycache__/
*.pyc
*.pyo
*.pyd

venv/
env/
.env/
*.egg-info/

.vscode/
.idea/
.DS_Store

logs/
*.log

*.ipynb
.ipynb_checkpoints/

# First: bring back the whole data/ directory
!data/

# Then exclude specific subfolders
data/raw/
data/processed/
data/reports/
data/eval/

# KEEP ONLY data/index
!data/index/
!data/index/*
!data/index/**/*

build/
dist/

cloudflared-linux-amd64.deb

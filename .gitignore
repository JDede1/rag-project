*.py[cod]
*.pyo
*.pyd
*.log
*.tmp
*.swp
*.bak
*.old

# Virtual environments
venv/
env/
.venv/
.conda/
*.env
*.venv
*.egg-info/
*.egg
.eggs/
.env/
.envrc
.DS_Store


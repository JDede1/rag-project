# =======================================
# RAG PROJECT - PRODUCTION-SAFE .gitignore
# =======================================

# =======================================
# DATA (NEVER PUSH LARGE FILES)
# =======================================
# Keep FAISS index (critical)
!data/index/
data/index/*

# Re-allow FAISS index + metadata
!data/index/rbc_faiss.index
!data/index/rbc_metadata.parquet
!data/index/rbc_embeddings.onnx
!data/index/rbc_tokenizer.json

# Block all other data
data/raw/
data/processed/
data/reports/

# Evaluation data SHOULD be kept
# (used in automated benchmarking)
!data/eval/

# Ignore Google Drive symlink if recreated
data -> /content/drive/MyDrive/rag_project_data

# =======================================
# LOGS AND TUNNEL FILES
# =======================================
*.log
logs/
cf_tunnel.log
rag_llm_url.txt

# =======================================
# PYTHON CACHE
# =======================================
__pycache__/
*.pyc
*.pyo

# =======================================
# MODEL WEIGHTS (NEVER PUSH)
# =======================================
*.bin
*.safetensors
*.pt

# HuggingFace cache
models/
huggingface/
.cache/
.env/

# =======================================
# EDITOR / SYSTEM FILES
# =======================================
.vscode/
.DS_Store
.idea/

# =======================================
# COLAB NOTEBOOK CHECKPOINTS
# =======================================
.ipynb_checkpoints/

# =======================================
# INTERNAL PYTHON CACHE
# =======================================
src/**/__pycache__/

# =======================================
# LOCAL DEV OR ARTIFACTS
# =======================================
*.old
*.tmp
*.bak

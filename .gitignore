# =======================================
# RAG PROJECT - PRODUCTION-SAFE .gitignore
# =======================================

# =======================================
# DATA
# =======================================

# Keep ONLY the FAISS index directory:
!data/index/

# Ignore everything else in /data
data/*
!data/index/

# Inside data/index, allow only the required files:
!data/index/rbc_faiss.index
!data/index/rbc_metadata.parquet

# Ignore anything else inside data/index
data/index/*

# Re-allow required files again (order matters)
!data/index/rbc_faiss.index
!data/index/rbc_metadata.parquet

# Keep evaluation sets (for RAG benchmarking)
!data/eval/
data/eval/*

# Re-allow evaluation files
!data/eval/*.jsonl


# =======================================
# LOGS & TUNNEL FILES
# =======================================
logs/
*.log
cf_tunnel.log
rag_llm_url.txt


# =======================================
# PYTHON CACHE
# =======================================
__pycache__/
*.pyc
*.pyo
*.pyd


# =======================================
# MODEL WEIGHTS (Local Dev Only)
# =======================================
# Ignore entire models/ folder except ONNX MPNet
models/*
!models/mpnet/
models/mpnet/*
!models/mpnet/model.onnx
!models/mpnet/tokenizer.json
!models/mpnet/config.json
!models/mpnet/special_tokens_map.json


# HuggingFace + temporary caches
huggingface/
.cache/
.env/


# =======================================
# EDITOR / SYSTEM FILES
# =======================================
.vscode/
.idea/
.DS_Store


# =======================================
# NOTEBOOK CHECKPOINTS
# =======================================
.ipynb_checkpoints/


# =======================================
# LOCAL DEV OR ARTIFACT FILES
# =======================================
*.old
*.tmp
*.bak

